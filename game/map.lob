#Game Map

A game map is a Petri net with additional decoration for the game: each place
knows whether it contains a dot for the player to eat, and each transition can
be marked as a ghost-spawn point. The net topology is the maze; the decorations
are the game-layer metadata.

Several built-in maps are supplied. The Classic map is a figure-eight. The
Split map demonstrates token splitting with a Y-junction and long restart
corridors. Diamond and Circuit extend fork-join into a proper maze. Mandala
scales splitting further still, into a two-level 1→2→4 cascade that
reconverges in pairs. Circuit and Mandala also have an escape layer that
cannot be drawn without crossing their forward corridors, so each names it
(see underpass below) and is drawn with it as a second plane.

    interface GamePlace extends Place {
      hasDot: boolean;
    }

    interface GameNet {
      net: PetriNet;
      ghostSpawns: string[];          // transition ids where ghosts emerge
      playerStarts: string[];         // place ids where player tokens begin
      startMarkings?: Map<string, number>; // token count per start place (default 1)
      nodeRadius?: number;            // override place drawing radius (default 24)
      underpass?: string[];           // transition ids drawn on the lower tier
    }

Some maps are not planar: an escape room that every corridor drains into
cannot be drawn without its arcs crossing the forward maze. Rather than
tangle the picture, such a map can name the transitions of that escape
layer, which also covers a long restart that has to come back round the
board. Every arc touching one of them is drawn as a dashed curve, a plane
beneath the solid corridors, and a crossing with it is not drawn as a
junction at all. This is a statement about the drawing only: the net, and
so the play, is the same whether or not a transition is named. What the
claim layer checks is that the solid corridors alone do not cross (see the
playtest module, sim/playtest.lob).

    function underpassArcIds(gn: GameNet): Set<string> {
      const marked = new Set(gn.underpass ?? []);
      return new Set(
        gn.net.arcs
          .filter(a => marked.has(a.source) || marked.has(a.target))
          .map(a => a.id),
      );
    }

    function gamePlace(
      net: PetriNet, id: string, label: string,
      x: number, y: number, hasDot = true,
    ): GamePlace {
      const p = addPlace(net, id, label, x, y) as GamePlace;
      p.hasDot = hasDot;
      return p;
    }

##Classic Map

The classic map is a figure-eight: two loops sharing a central place.
Nodes are spread generously so every corridor is clearly visible. The player
starts at Centre; one ghost spawns at the top-left split and exits to Top Mid,
well away from the player.

    function makeClassicMap(): GameNet {
      const net = makeNet();

      // Centre of the figure-eight
      gamePlace(net, 'c',  'Centre',    467, 440, false);
      // Top loop
      gamePlace(net, 'tl', 'Top Left',  160, 200);
      gamePlace(net, 'tm', 'Top Mid',   467, 130);
      gamePlace(net, 'tr', 'Top Right', 774, 200);
      // Bottom loop
      gamePlace(net, 'bl', 'Bot Left',  160, 680);
      gamePlace(net, 'bm', 'Bot Mid',   467, 750);
      gamePlace(net, 'br', 'Bot Right', 774, 680);

      // Top transitions — placed at midpoints with 120-200px corridors on each side
      addTransition(net, 'tc',   'Top-Centre',      300, 310);
      addTransition(net, 'tls',  'Top-L Split',     280, 165);
      addTransition(net, 'tm_t', 'Top-Mid Door',    660, 165);
      addTransition(net, 'trs',  'Top-R Split',     640, 310);
      // Bottom transitions (symmetric)
      addTransition(net, 'bc',   'Bot-Centre',      300, 570);
      addTransition(net, 'bls',  'Bot-L Split',     280, 715);
      addTransition(net, 'bm_t', 'Bot-Mid Door',    660, 715);
      addTransition(net, 'brs',  'Bot-R Split',     640, 570);

      // Top loop: c → tc → tl → tls → tm → tm_t → tr → trs → c
      addArc(net, 'a1',  'c',   'tc');
      addArc(net, 'a2',  'tc',  'tl');
      addArc(net, 'a3',  'tl',  'tls');
      addArc(net, 'a4',  'tls', 'tm');
      addArc(net, 'a5',  'tm',  'tm_t');
      addArc(net, 'a6',  'tm_t','tr');
      addArc(net, 'a7',  'tr',  'trs');
      addArc(net, 'a8',  'trs', 'c');

      // Bottom loop: c → bc → bl → bls → bm → bm_t → br → brs → c
      addArc(net, 'a9',  'c',   'bc');
      addArc(net, 'a10', 'bc',  'bl');
      addArc(net, 'a11', 'bl',  'bls');
      addArc(net, 'a12', 'bls', 'bm');
      addArc(net, 'a13', 'bm',  'bm_t');
      addArc(net, 'a14', 'bm_t','br');
      addArc(net, 'a15', 'br',  'brs');
      addArc(net, 'a16', 'brs', 'c');

      // Ghost spawns at 'tls' → exits to Top Mid, far from player start Centre
      return { net, ghostSpawns: ['tls'], playerStarts: ['c'] };
    }

##Split Map

The split map teaches token splitting. The key transition is the Fork: it
has ONE input arc (from Lobby) and TWO output arcs (to Upper Arm and Lower
Arm). Firing Fork with a single token in Lobby creates two tokens — the
chomper duplicates. The player must then steer both chompers independently.

Two long restart corridors run along the top and bottom of the canvas,
looping Finish Upper and Finish Lower back to Start. These are intentionally
long to make the return journey feel like a proper map traversal.

    function makeSplitMap(): GameNet {
      const net = makeNet();

      // Main path: left to right
      gamePlace(net, 'start',    'Start',         120, 440, false);
      gamePlace(net, 'lobby',    'Lobby',          350, 440);
      gamePlace(net, 'upper',    'Upper Arm',      590, 260);
      gamePlace(net, 'lower',    'Lower Arm',      590, 620);
      gamePlace(net, 'fin_up',   'Finish Upper',   820, 180);
      gamePlace(net, 'fin_lo',   'Finish Lower',   820, 700);

      // t_fork has TWO output arcs — this is the split transition
      addTransition(net, 't_enter', 'Enter',       235, 440);
      addTransition(net, 't_fork',  'Fork',        480, 440);   // ← SPLIT
      addTransition(net, 't_up',    'Up Door',     710, 210);
      addTransition(net, 't_lo',    'Lo Door',     710, 670);
      // Long restart corridors running across top and bottom of the canvas
      addTransition(net, 't_rst_u', 'Restart Up',  350, 100);
      addTransition(net, 't_rst_l', 'Restart Lo',  350, 780);

      // Entry
      addArc(net, 'b1', 'start',  't_enter');
      addArc(net, 'b2', 't_enter','lobby');
      // Fork: one input, two outputs — the token split
      addArc(net, 'b3', 'lobby',  't_fork');
      addArc(net, 'b4', 't_fork', 'upper');   // output 1
      addArc(net, 'b5', 't_fork', 'lower');   // output 2
      // Upper arm
      addArc(net, 'b6', 'upper',  't_up');
      addArc(net, 'b7', 't_up',   'fin_up');
      // Lower arm
      addArc(net, 'b8', 'lower',  't_lo');
      addArc(net, 'b9', 't_lo',   'fin_lo');
      // Long restart corridors back to start
      addArc(net, 'b10','fin_up', 't_rst_u');
      addArc(net, 'b11','t_rst_u','start');
      addArc(net, 'b12','fin_lo', 't_rst_l');
      addArc(net, 'b13','t_rst_l','start');

      // Ghost spawns at t_up, exits to Finish Upper (far from Start)
      return { net, ghostSpawns: ['t_up'], playerStarts: ['start'] };
    }

##Diamond Map

The diamond extends the basic split-then-merge with optional detour rooms
on each arm. Fork sends one token into the Upper arm and one into the
Lower arm. Each arm offers a direct corridor (eat one dot) or a detour
room (eat two dots but take an extra step). Sync requires tokens in BOTH
arm exits simultaneously. The ghost spawns at Sync and reaches Start in a
single hop (Finish → Restart → Start); Start's only onward transition is
Fork itself, so a ghost arriving there replicates almost immediately, the
same mechanism behind Mandala's fork-replication — and this map has no
escape routes to recover a stranded token the way Mandala or Circuit do.

A stranded lone token here really was fatal, once: before the game engine
gained deadlock detection, a marking like {l2: 1} with Sync unsatisfied
and nowhere else to go simply froze — no enabled transitions, ever again,
for any player regardless of skill. Diamond was genuinely unwinnable in
that state, not just difficult. Deadlock detection (added for Mandala's
benefit, generic to any map) turns that freeze into a costed, recoverable
reset instead, and that recoverability — not cleverer play — is the real
reason Diamond is winnable at all now.

Once it's recoverable, a hand-written scripted playthrough still reported
Diamond as unwinnable: 0 wins in 200 seeded trials (sim/playtest.lob). That
part was a tooling artifact, not a map property — the script was rigid
(a fixed detour order regardless of where the ghost was) and couldn't
exploit the recovery. A generic reactive policy, tried once the rigidity
was suspected, wins roughly three-quarters of the time. The reason a
stranded token costs so little even though it looks catastrophic: dots
already eaten stay eaten across a reset, so losing a life is lost progress
on timing, not lost progress on the map — a few cheap failed attempts, each banking
whatever dots it reached, comfortably clears all seven dot places before
three lives run out. The restart corridor arcs over the top to complete
the cycle.

    function _arcsBipartite(gn: GameNet): boolean {
      return gn.net.arcs.every(a =>
        gn.net.places.has(a.source) !== gn.net.places.has(a.target)
      );
    }

A node that sits on top of an arc it isn't part of reads, on screen, as
though that arc terminates there — exactly the ambiguity Mandala's corridor
places had before being moved off the fork-to-petal diagonal they used to
sit on. This check catches that class of layout bug for any map: for every
node, and every arc it's not an endpoint of, the node must stay clear of
the arc's line segment by some minimum pixel distance. Arcs on a map's lower
tier are skipped, because they are drawn as curves and a straight line
between their ends says nothing about what they pass near. A violation is
reported as a sentence naming the node and the arc, so a failing claim says
what to move instead of only that something is wrong.

    function _distToSegment(
      px: number, py: number,
      x1: number, y1: number, x2: number, y2: number,
    ): number {
      const dx = x2 - x1, dy = y2 - y1;
      const lenSq = dx * dx + dy * dy;
      const t = lenSq === 0 ? 0 :
        Math.max(0, Math.min(1, ((px - x1) * dx + (py - y1) * dy) / lenSq));
      const ex = x1 + t * dx, ey = y1 + t * dy;
      return Math.hypot(px - ex, py - ey);
    }

    function _clearanceViolations(gn: GameNet, clearance = 20): string[] {
      const { net } = gn;
      const byId = new Map([...net.places.values(), ...net.transitions.values()]
        .map(n => [n.id, n]));
      const found: string[] = [];
      // Lower-tier arcs are drawn as curves, so their straight line says
      // nothing about what they pass near.
      const curved = underpassArcIds(gn);
      for (const node of byId.values()) {
        for (const arc of net.arcs) {
          if (curved.has(arc.id)) continue;
          if (arc.source === node.id || arc.target === node.id) continue;
          const a = byId.get(arc.source), b = byId.get(arc.target);
          if (!a || !b) continue;
          const d = _distToSegment(node.x, node.y, a.x, a.y, b.x, b.y);
          if (d < clearance) found.push(`${node.id} is ${Math.round(d)}px from ${arc.id}`);
        }
      }
      return found;
    }

    function _nodesClearOfForeignArcs(gn: GameNet, clearance = 20): boolean {
      return _clearanceViolations(gn, clearance).length === 0;
    }

    function makeDiamondMap(): GameNet {
      const net = makeNet();

      // Anchor places
      gamePlace(net, 'start',  'Start',     80,  435, false);
      gamePlace(net, 'fin',    'Finish',    870,  435, false);
      // Upper arm: straight path + optional side room
      gamePlace(net, 'u1',     'Upper In',  370,  235);
      gamePlace(net, 'u_side', 'U-Side',    490,  120);
      gamePlace(net, 'u2',     'Upper Out', 630,  235);
      // Lower arm: straight path + optional side room
      gamePlace(net, 'l1',     'Lower In',  370,  635);
      gamePlace(net, 'l_side', 'L-Side',    490,  748);
      gamePlace(net, 'l2',     'Lower Out', 630,  635);

      // Main structure
      addTransition(net, 't_fork',   'Fork',      230,  435);  // SPLIT → {u1,l1}
      addTransition(net, 't_sync',   'Sync',      730,  435);  // JOIN {u2,l2} →
      addTransition(net, 't_rst',    'Restart',   490,   30);  // fin → start (over top)
      // Upper direct path
      addTransition(net, 't_u_main', 'U-Main',    500,  235);
      // Upper detour
      addTransition(net, 't_u_in',   'U-Det In',  425,  173);
      addTransition(net, 't_u_out',  'U-Det Out', 565,  177);
      // Lower direct path
      addTransition(net, 't_l_main', 'L-Main',    500,  635);
      // Lower detour
      addTransition(net, 't_l_in',   'L-Det In',  425,  697);
      addTransition(net, 't_l_out',  'L-Det Out', 565,  697);

      // Fork
      addArc(net, 'd1',  'start',  't_fork');
      addArc(net, 'd2',  't_fork', 'u1');
      addArc(net, 'd3',  't_fork', 'l1');
      // Upper direct
      addArc(net, 'd4',  'u1',    't_u_main');
      addArc(net, 'd5',  't_u_main', 'u2');
      // Upper detour
      addArc(net, 'd6',  'u1',    't_u_in');
      addArc(net, 'd7',  't_u_in', 'u_side');
      addArc(net, 'd8',  'u_side', 't_u_out');
      addArc(net, 'd9',  't_u_out', 'u2');
      // Lower direct
      addArc(net, 'd10', 'l1',    't_l_main');
      addArc(net, 'd11', 't_l_main', 'l2');
      // Lower detour
      addArc(net, 'd12', 'l1',    't_l_in');
      addArc(net, 'd13', 't_l_in', 'l_side');
      addArc(net, 'd14', 'l_side', 't_l_out');
      addArc(net, 'd15', 't_l_out', 'l2');
      // Sync
      addArc(net, 'd16', 'u2',    't_sync');
      addArc(net, 'd17', 'l2',    't_sync');
      addArc(net, 'd18', 't_sync', 'fin');
      // Restart
      addArc(net, 'd19', 'fin',   't_rst');
      addArc(net, 'd20', 't_rst', 'start');

      return { net, ghostSpawns: ['t_sync'], playerStarts: ['start'] };
    }

##Circuit Map

The circuit map scales the fork-join idea into a proper maze. Fork at
the depot sends tokens into a north arm (NW → North → NE) and a south
arm (SW → South → SE) simultaneously. Only when both arm-end tokens are
present can Sync fire, granting access to the East reward room.

Without an escape route, losing one chomper to a ghost at an arm-end
creates a permanent deadlock: the survivor can reach its arm-end but
Sync never enables. To fix this, NE and SE each have an interior escape
transition leading to a central Mid room, which routes back to Depot.
A surviving token can loop home, re-fork, and try again. This also keeps
the ghost moving rather than stuck waiting at an arm-end.

Mid is reached from the arm-ends across the middle of the ring, and the
long restart has to come back from East to Depot, so both would cross the
forward arms if drawn like them. They are the map's underpass: the two
escapes, Mid's way home and Restart are drawn as dashed curves sweeping
round the outside of the solid ring, which is left as a plain loop with no
crossings. Restart sits above the ring, so its two legs bow out either side
of it.

    function makeCircuitMap(): GameNet {
      const net = makeNet();

      gamePlace(net, 'depot', 'Depot',  80, 440, false);
      gamePlace(net, 'nw',    'NW',    300, 240);
      gamePlace(net, 'nn',    'North', 510, 160);
      gamePlace(net, 'ne',    'NE',    720, 240);
      gamePlace(net, 'sw',    'SW',    300, 640);
      gamePlace(net, 'ss',    'South', 510, 720);
      gamePlace(net, 'se',    'SE',    720, 640);
      gamePlace(net, 'east',  'East',  880, 440);
      gamePlace(net, 'mid',   'Mid',   490, 440);  // interior escape hub

      addTransition(net, 't_fork',   'Fork',    200, 440);  // SPLIT: depot→{nw,sw}
      addTransition(net, 't_nw_nn',  'NW→N',    405, 200);
      addTransition(net, 't_nn_ne',  'N→NE',    615, 200);
      addTransition(net, 't_sw_ss',  'SW→S',    405, 680);
      addTransition(net, 't_ss_se',  'S→SE',    615, 680);
      addTransition(net, 't_sync',   'Sync',    800, 440);  // JOIN: {ne,se}→east
      addTransition(net, 't_rst',    'Restart', 510,  50);  // long restart, drawn as two sweeps round the ring
      addTransition(net, 't_ne_mid', 'NE→Mid',  620, 330);  // escape from NE
      addTransition(net, 't_se_mid', 'SE→Mid',  620, 550);  // escape from SE
      addTransition(net, 't_mid_dep','Mid→Home',285, 380);  // return to depot

      addArc(net, 'c1',  'depot',    't_fork');
      addArc(net, 'c2',  't_fork',   'nw');
      addArc(net, 'c3',  't_fork',   'sw');
      addArc(net, 'c4',  'nw',       't_nw_nn');
      addArc(net, 'c5',  't_nw_nn',  'nn');
      addArc(net, 'c6',  'nn',       't_nn_ne');
      addArc(net, 'c7',  't_nn_ne',  'ne');
      addArc(net, 'c8',  'sw',       't_sw_ss');
      addArc(net, 'c9',  't_sw_ss',  'ss');
      addArc(net, 'c10', 'ss',       't_ss_se');
      addArc(net, 'c11', 't_ss_se',  'se');
      addArc(net, 'c12', 'ne',       't_sync');
      addArc(net, 'c13', 'se',       't_sync');
      addArc(net, 'c14', 't_sync',   'east');
      addArc(net, 'c15', 'east',     't_rst');
      addArc(net, 'c16', 't_rst',    'depot');
      addArc(net, 'c17', 'ne',       't_ne_mid');
      addArc(net, 'c18', 't_ne_mid', 'mid');
      addArc(net, 'c19', 'se',       't_se_mid');
      addArc(net, 'c20', 't_se_mid', 'mid');
      addArc(net, 'c21', 'mid',      't_mid_dep');
      addArc(net, 'c22', 't_mid_dep','depot');

      return {
        net, ghostSpawns: ['t_sync'], playerStarts: ['depot'],
        underpass: ['t_ne_mid', 't_se_mid', 't_mid_dep', 't_rst'],
      };
    }

##Mandala Map

Mandala teaches splitting as a *cascade* rather than a single fork. The first
fork sends one token west and one east; each of those immediately forks
again, so one token becomes two becomes four. The four then converge in
pairs through two synchronising joins, and those two survivors converge
through a final join back to one.

A petal does not feed its join directly — each arm has a corridor step
(petal → corridor place) between arrival and the join. Because only one
transition fires per player turn, the two tokens born from the same fork
still have to be advanced along their corridors on separate turns, which is
what actually creates the coordination and timing tension the cascade is
meant to teach; wiring a petal straight into its join would let both sides
arrive "for free" in the same fire that created them.

Each corridor place also has an escape route home, routed through a shared
Mid room exactly like the Circuit map's fix: because every join here is a
hard two-token synchronisation with no slack, losing one token to a ghost
would otherwise strand its twin forever. The escape lets a stranded
survivor bail out and re-fork rather than deadlocking that arm permanently.
Routing through Mid rather than straight to Hub adds one hop to every
escape, which also means one extra turn before a wandering ghost can reach
the fork machinery and replicate — the same slowdown Circuit's Mid room
gives its own escape routes, for the same reason. This alone turned out
not to be enough (a seeded simulation, sim/playtest.lob, put the win rate
at around 1% even with a greedy player) — the rest of the net is compact
enough that one extra hop barely delays the ghost reaching a fork at all.

The fan handle is the stronger fix for the same problem: a long, one-way,
branchless corridor (Den → H4 → H3 → H2 → H1 → Mid) that the ghost spawns
at the far end of, five guaranteed hops from Hub via Mid rather than the
one or two hops every node tried before it worked out to. Nothing else
ever visits it — the handle places carry no dots, so winning never
requires going there, and its only job is to cost the ghost real turns
before it becomes dangerous at all.

The drawing follows the structure. Each side's fork opens into a diamond —
fork, two parallel rails, a join — so the four petals sit two to a side and
no rail crosses another: the outer rails are NW and NE, the inner ones SW
and SE. The two diamonds meet in the final join, and Hub, Fork, Restart and
Final Sync sit on the centre line between them. Goal sits left of that
line, at the height of Restart, and Mid's way home mirrors it on the right,
so the two returns balance either side of Restart.

Everything that is not part of the forward cascade is drawn on the lower
tier (see underpass above): the four escapes, Mid's way home, Restart and
the whole fan handle. Mid sits under Final Sync on the centre line, the
handle runs along the bottom edge and climbs straight up into it, and the
outer escapes loop down the outside of the diamonds. Mid touches both rails
of both diamonds, which no drawing of the solid cascade can do without
crossing, which is why it is on its own plane. The solid corridors do not
cross anywhere.

    function makeMandalaMap(): GameNet {
      const net = makeNet();

      // Hub and the two inner nodes from the level-1 fork
      gamePlace(net, 'hub', 'Hub',         475, 290, false);
      gamePlace(net, 'n1',  'Inner West',  200, 130);
      gamePlace(net, 'n2',  'Inner East',  750, 130);

      // Level-2 fork targets — the four petals. Each side's fork opens
      // into a diamond (fork, two rails, join), so the two petals of a
      // side sit side by side and their rails run parallel without ever
      // crossing: outer rail NW / NE, inner rail SW / SE.
      gamePlace(net, 'p_nw', 'NW Petal', 110, 250);
      gamePlace(net, 'p_sw', 'SW Petal', 290, 250);
      gamePlace(net, 'p_se', 'SE Petal', 660, 250);
      gamePlace(net, 'p_ne', 'NE Petal', 840, 250);

      // Corridor places — the travel step between a petal and its join,
      // directly below their petal so each rail stays a straight line.
      gamePlace(net, 'nw_c', 'NW Corridor', 110, 370);
      gamePlace(net, 'sw_c', 'SW Corridor', 290, 370);
      gamePlace(net, 'se_c', 'SE Corridor', 660, 370);
      gamePlace(net, 'ne_c', 'NE Corridor', 840, 370);

      // Reconvergence collectors, and the goal. The goal sits above the
      // final join, inside the ring the four rails make, left of the
      // centre line and mirrored on the right by Mid's way home. Goal,
      // Restart and Mid's way home share one height, so the two returns
      // sit either side of Restart in a row.
      gamePlace(net, 'c_w',  'West Collector', 200, 500);
      gamePlace(net, 'c_e',  'East Collector', 750, 500);
      gamePlace(net, 'goal', 'Goal',           405, 375);
      gamePlace(net, 'mid',  'Mid',            475, 640);  // shared escape hub

      // The fan handle — a one-way chain with no branches and no dots,
      // existing purely to put real distance between the ghost's spawn
      // and the fork machinery. Earlier spawn placements (a petal, then
      // Mid's escape network) all turned out to be within a hop or two of
      // Hub regardless of which node was chosen, because the rest of the
      // net is compact; a dedicated corridor is the only way to actually
      // buy turns rather than just relocate the same short distance.
      gamePlace(net, 'den', 'Ghost Den', 50,  740, false);
      gamePlace(net, 'h4',  'Handle 4',  156, 740, false);
      gamePlace(net, 'h3',  'Handle 3',  262, 740, false);
      gamePlace(net, 'h2',  'Handle 2',  368, 740, false);
      gamePlace(net, 'h1',  'Handle 1',  475, 740, false);

      // Forks
      addTransition(net, 't_fork0',   'Fork',   475, 210);  // hub → n1,n2
      addTransition(net, 't_fork_n1', 'Fork W', 200, 190);  // n1 → petals
      addTransition(net, 't_fork_n2', 'Fork E', 750, 190);  // n2 → petals

      // Petal → corridor travel
      addTransition(net, 't_nw_c', 'NW Corridor Door', 110, 310);
      addTransition(net, 't_sw_c', 'SW Corridor Door', 290, 310);
      addTransition(net, 't_se_c', 'SE Corridor Door', 660, 310);
      addTransition(net, 't_ne_c', 'NE Corridor Door', 840, 310);

      // Joins
      addTransition(net, 't_join_w', 'West Sync',  200, 440);  // → c_w
      addTransition(net, 't_join_e', 'East Sync',  750, 440);  // → c_e
      addTransition(net, 't_join',   'Final Sync', 475, 540);  // → goal

      // Restart — on the centre line, at the height of Goal and Mid's way
      // home, which sit either side of it
      addTransition(net, 't_rst', 'Restart', 475, 375);         // goal → hub

      // Escape routes from each corridor place into the shared Mid room
      addTransition(net, 't_nwc_esc', 'NW Escape', 150, 620);
      addTransition(net, 't_swc_esc', 'SW Escape', 330, 480);
      addTransition(net, 't_nec_esc', 'NE Escape', 800, 620);
      addTransition(net, 't_sec_esc', 'SE Escape', 620, 480);
      addTransition(net, 't_mid_home', 'Mid->Home', 545, 375);  // mirrors Goal about x=475

      // Fan handle — one-way, a long tail along the bottom edge
      addTransition(net, 't_den_h4', 'Den->H4', 103, 740);
      addTransition(net, 't_h4_h3',  'H4->H3',  209, 740);
      addTransition(net, 't_h3_h2',  'H3->H2',  315, 740);
      addTransition(net, 't_h2_h1',  'H2->H1',  421, 740);
      addTransition(net, 't_h1_mid', 'H1->Mid', 475, 690);

      // Level-1 fork (1 → 2)
      addArc(net, 'm1', 'hub',     't_fork0');
      addArc(net, 'm2', 't_fork0', 'n1');
      addArc(net, 'm3', 't_fork0', 'n2');
      // Level-2 forks (2 → 4)
      addArc(net, 'm4', 'n1',       't_fork_n1');
      addArc(net, 'm5', 't_fork_n1', 'p_nw');
      addArc(net, 'm6', 't_fork_n1', 'p_sw');
      addArc(net, 'm7', 'n2',       't_fork_n2');
      addArc(net, 'm8', 't_fork_n2', 'p_ne');
      addArc(net, 'm9', 't_fork_n2', 'p_se');
      // Petal → corridor
      addArc(net, 'm10', 'p_nw',   't_nw_c');
      addArc(net, 'm11', 't_nw_c', 'nw_c');
      addArc(net, 'm12', 'p_sw',   't_sw_c');
      addArc(net, 'm13', 't_sw_c', 'sw_c');
      addArc(net, 'm14', 'p_ne',   't_ne_c');
      addArc(net, 'm15', 't_ne_c', 'ne_c');
      addArc(net, 'm16', 'p_se',   't_se_c');
      addArc(net, 'm17', 't_se_c', 'se_c');
      // Mid joins (4 → 2) — a true sync, both corridor arrivals required
      addArc(net, 'm18', 'nw_c',     't_join_w');
      addArc(net, 'm19', 'sw_c',     't_join_w');
      addArc(net, 'm20', 't_join_w', 'c_w');
      addArc(net, 'm21', 'ne_c',     't_join_e');
      addArc(net, 'm22', 'se_c',     't_join_e');
      addArc(net, 'm23', 't_join_e', 'c_e');
      // Final join (2 → 1)
      addArc(net, 'm24', 'c_w',    't_join');
      addArc(net, 'm25', 'c_e',    't_join');
      addArc(net, 'm26', 't_join', 'goal');
      // Restart
      addArc(net, 'm27', 'goal',  't_rst');
      addArc(net, 'm28', 't_rst', 'hub');
      // Escape routes — a stranded singleton in a corridor can bail home,
      // via Mid rather than straight to Hub (see prose above for why).
      addArc(net, 'm29', 'nw_c',       't_nwc_esc');
      addArc(net, 'm30', 't_nwc_esc',  'mid');
      addArc(net, 'm31', 'sw_c',       't_swc_esc');
      addArc(net, 'm32', 't_swc_esc',  'mid');
      addArc(net, 'm33', 'ne_c',       't_nec_esc');
      addArc(net, 'm34', 't_nec_esc',  'mid');
      addArc(net, 'm35', 'se_c',       't_sec_esc');
      addArc(net, 'm36', 't_sec_esc',  'mid');
      addArc(net, 'm37', 'mid',        't_mid_home');
      addArc(net, 'm38', 't_mid_home', 'hub');
      // Fan handle — one-way, Den to Mid (which already connects to Hub
      // via t_mid_home, so the last leg reuses a route already proven
      // clear rather than threading a new line through the fork cluster).
      addArc(net, 'm39', 'den', 't_den_h4');
      addArc(net, 'm40', 't_den_h4', 'h4');
      addArc(net, 'm41', 'h4',  't_h4_h3');
      addArc(net, 'm42', 't_h4_h3', 'h3');
      addArc(net, 'm43', 'h3',  't_h3_h2');
      addArc(net, 'm44', 't_h3_h2', 'h2');
      addArc(net, 'm45', 'h2',  't_h2_h1');
      addArc(net, 'm46', 't_h2_h1', 'h1');
      addArc(net, 'm47', 'h1',  't_h1_mid');
      addArc(net, 'm48', 't_h1_mid', 'mid');

      // Ghost spawns in the Den, at the far end of the fan handle — five
      // guaranteed hops from Hub (via Mid), not one or two like every
      // spawn tried before it.
      return {
        net, ghostSpawns: ['t_den_h4'], playerStarts: ['hub'],
        underpass: [
          't_nwc_esc', 't_swc_esc', 't_nec_esc', 't_sec_esc', 't_mid_home',
          't_rst',
          't_den_h4', 't_h4_h3', 't_h3_h2', 't_h2_h1', 't_h1_mid',
        ],
      };
    }

The full-traversal claim below fires one deterministic sequence — ignoring
ghosts — from a single token in Hub through both fork levels, both corridors
on every arm, both mid-joins, and the final join, and checks the whole
cascade conserves down to exactly one token in Goal. This is the map's
central pedagogical claim made checkable: split four ways, converge back to
one, nothing lost along the way.

    interface MandalaTrace {
      atGoal: number;
      totalElsewhere: number;
    }

    function _mandalaFullTraversal(): MandalaTrace {
      const gn = makeMandalaMap();
      let m = emptyMarking();
      markingAddTokens(m, 'hub', 1);
      const seq = [
        't_fork0', 't_fork_n1', 't_fork_n2',
        't_nw_c', 't_sw_c', 't_ne_c', 't_se_c',
        't_join_w', 't_join_e', 't_join',
      ];
      for (const t of seq) m = fire(gn.net, m, t);
      const atGoal = tokenCount(m, 'goal');
      const total = [...m.values()].reduce((a, b) => a + b, 0);
      return { atGoal, totalElsewhere: total - atGoal };
    }

##Grid Map

The grid map is a test fixture rather than a playable level — the 10×10
topology is too dense for fun gameplay but covers properties the playable
maps cannot: 101 places, four fork junctions at quadrant centres, a join
room reachable only by two converging tokens, a non-default nodeRadius of
12, and hasDot=false on the start place. It exists to give the claim layer
and the PNML IO module a large, structurally rich net to work with.

    function makeGridMap(): GameNet {
      const net = makeNet();
      const ROWS = 10, COLS = 10;
      const STEP = 80;
      const OX = Math.round((940 - (COLS - 1) * STEP) / 2);
      const OY = Math.round((780 - (ROWS - 1) * STEP) / 2);

      // Fork junctions: arrival fires a split → RIGHT and DOWN simultaneously.
      // Placed at four quadrant centres; the grid centre uses a join room instead.
      const FORKS = new Set(['2_2', '2_7', '7_2', '7_7']);

      // --- Places ---
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const isStart = r === 0 && c === 0;
          gamePlace(net, `g${r}_${c}`, `${r}:${c}`,
            OX + c * STEP, OY + r * STEP, !isStart);
        }
      }

      // --- Transitions ---
      for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
          const isFork = FORKS.has(`${r}_${c}`) && c < COLS - 1 && r < ROWS - 1;

          if (isFork) {
            // One fork transition: single token → right AND down at once
            const tid = `gf${r}_${c}`;
            const tx = OX + c * STEP + Math.round(STEP * 0.35);
            const ty = OY + r * STEP + Math.round(STEP * 0.35);
            addTransition(net, tid, 'Fork', tx, ty);
            addArc(net, `af${r}_${c}i`, `g${r}_${c}`, tid);
            addArc(net, `af${r}_${c}r`, tid, `g${r}_${c + 1}`);
            addArc(net, `af${r}_${c}d`, tid, `g${r + 1}_${c}`);
          } else {
            // Choice: right corridor
            if (c < COLS - 1) {
              const tid = `gr${r}_${c}`;
              addTransition(net, tid, 'R',
                OX + c * STEP + STEP / 2, OY + r * STEP);
              addArc(net, `ar${r}_${c}a`, `g${r}_${c}`, tid);
              addArc(net, `ar${r}_${c}b`, tid, `g${r}_${c + 1}`);
            }
            // Choice: down corridor
            if (r < ROWS - 1) {
              const tid = `gd${r}_${c}`;
              addTransition(net, tid, 'D',
                OX + c * STEP, OY + r * STEP + STEP / 2);
              addArc(net, `ad${r}_${c}a`, `g${r}_${c}`, tid);
              addArc(net, `ad${r}_${c}b`, tid, `g${r + 1}_${c}`);
            }
          }
        }
      }

      // --- Central join room ---
      // Only reachable when g5_6 AND g6_5 are occupied simultaneously —
      // requires a token split somewhere else first, then converging both halves.
      const roomX = OX + 5 * STEP + 45;               // 555
      const roomY = OY + 4 * STEP + 35;               // 385
      gamePlace(net, 'room', 'Room', roomX, roomY);
      const joinX = OX + 5 * STEP + 50;               // 560
      const joinY = OY + 5 * STEP + 50;               // 480
      addTransition(net, 'tj_room', 'Join', joinX, joinY);
      addArc(net, 'aj_r_i1', 'g5_6', 'tj_room');
      addArc(net, 'aj_r_i2', 'g6_5', 'tj_room');
      addArc(net, 'aj_r_o',  'tj_room', 'room');
      // Exit: room resurfaces at g3_5 (two rows above the join)
      const exitX = OX + 5 * STEP + 25;               // 535
      const exitY = OY + 3 * STEP + 55;               // 325
      addTransition(net, 't_room_out', 'Exit', exitX, exitY);
      addArc(net, 'aj_r_e1', 'room', 't_room_out');
      addArc(net, 'aj_r_e2', 't_room_out', 'g3_5');

      // --- Restart: bottom-right → top-left ---
      const rxEnd = OX + (COLS - 1) * STEP;
      const ryEnd = OY + (ROWS - 1) * STEP;
      addTransition(net, 'g_rst', 'Restart', rxEnd + 55, ryEnd);
      addArc(net, 'ar_rst_a', `g${ROWS - 1}_${COLS - 1}`, 'g_rst');
      addArc(net, 'ar_rst_b', 'g_rst', 'g0_0');

      // Ghost spawns at centre-right transition, emerges at g4_5
      return { net, ghostSpawns: ['gr4_4'], playerStarts: ['g0_0'], nodeRadius: 12 };
    }


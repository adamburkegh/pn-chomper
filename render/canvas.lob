#Render Canvas

The canvas renderer draws the Petri net game world onto an HTML5 Canvas. It
is a pure read operation on the GameState — it never mutates anything. The
renderer is called once per animation frame and redraws the entire scene.

The visual vocabulary maps Petri net concepts to game imagery. Places are
circles; a place with a dot shows a pellet inside, a place with a chomper
token shows the pac-man arc, a place with a ghost token shows the ghost icon.
Transitions are rectangles (doorways); enabled ones glow yellow. Arcs are
drawn as wide corridors with a directional highlight, giving the net a
proper maze aesthetic.

Place and transition names are for whoever is building or debugging a map,
not for the player, who reads the board by its shapes and colours — so
labels are off unless the renderer's showLabels is switched on.

    interface Renderer {
      canvas: HTMLCanvasElement;
      ctx: CanvasRenderingContext2D;
      showLabels: boolean;
    }

    function makeRenderer(canvas: HTMLCanvasElement): Renderer {
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Cannot get 2D context');
      return { canvas, ctx, showLabels: false };
    }

    function clearCanvas(r: Renderer): void {
      r.ctx.fillStyle = '#111';
      r.ctx.fillRect(0, 0, r.canvas.width, r.canvas.height);
    }

##Drawing Corridors

Arcs are drawn as wide maze corridors: a dark filled band with a lighter
centre stripe and a small arrowhead triangle at the target end to indicate
direction. The corridor is clipped short at both ends so it does not
overdraw the place circles or transition rectangles.

An arc that closes a cycle, or feeds a transition that only closes cycles
(see #Petri Net's returnArcs), is drawn differently from the rest: a dashed
line with no band, so a return reads as dashed all the way from the place
it leaves to the place it reaches. These are the arcs
that carry a token back toward where it started — in a workflow net, the
usually-undrawn arc from the final place back to the initial one is the
canonical example, and a map's restart is exactly that arc made visible.
They are what makes a map playable as a game rather than a one-shot, so
they are drawn lighter, not hidden: they read as "this leads back" instead
of as another forward corridor cutting across the maze.

When a transition is focused (hovered), its own arcs are drawn bright and
every other arc is dimmed, so what a doorway does can be read even in a
tangled drawing.

Hover does not exist on a touch screen, so the same colour is used in a
muted form for every arc touching a doorway the player can fire right now,
with no pointer needed. Hovering still takes the full accent for its own
doorway and dims the rest, muted ones included.

An arc on a map's lower tier (see #Game Map's underpass) takes the same
dashed look but curves, bowing away from the middle of the board, so it
reads as passing beneath the solid corridors rather than joining them.

    type CorridorLook = 'forward' | 'return' | 'under';

    interface CorridorStyle {
      look: CorridorLook;
      alpha: number;
      accent: boolean;
      muted?: boolean;
      bow?: number;
    }

    const NORMAL_CORRIDOR: CorridorStyle = {
      look: 'forward', alpha: 1, accent: false,
    };

The corridor structure is the puzzle itself, so it has to be visible against
the background rather than merely present: edges sit at roughly 4:1
contrast, not the 1.1-1.5:1 a near-black-on-black band gave. The palette is
kept in one place so the corridors and the bridges drawn across crossings
cannot drift apart.

    const DIM_ALPHA = 0.4;

    interface CorridorColours {
      fill: string; edge: string; stripe: string; arrow: string; dashed: string;
    }

    const PLAIN_COLOURS: CorridorColours = {
      fill: '#222226', edge: '#707078', stripe: '#34343a',
      arrow: '#8a8a92', dashed: '#808088',
    };

    const ACCENT_COLOURS: CorridorColours = {
      fill: '#2e2a12', edge: '#8a7a1a', stripe: '#4a4018',
      arrow: '#ffe000', dashed: '#c9a800',
    };

    const MUTED_COLOURS: CorridorColours = {
      fill: '#26230f', edge: '#6e6318', stripe: '#3a3412',
      arrow: '#bfa800', dashed: '#a08c10',
    };

    function coloursFor(style: CorridorStyle): CorridorColours {
      if (style.accent) return ACCENT_COLOURS;
      return style.muted ? MUTED_COLOURS : PLAIN_COLOURS;
    }

    function drawCorridor(
      ctx: CanvasRenderingContext2D,
      x1: number, y1: number,
      x2: number, y2: number,
      style: CorridorStyle = NORMAL_CORRIDOR,
    ): void {
      const angle  = Math.atan2(y2 - y1, x2 - x1);
      const len    = Math.hypot(x2 - x1, y2 - y1);
      // Adaptive margin/width: short arcs (dense maps) use tighter values
      const margin = Math.min(28, Math.max(8, len * 0.30));
      const cw     = Math.min(16, Math.max(4, len * 0.18));

      const sx = x1 + Math.cos(angle) * margin;
      const sy = y1 + Math.sin(angle) * margin;
      const ex = x2 - Math.cos(angle) * margin;
      const ey = y2 - Math.sin(angle) * margin;

      if (len < 20) return;

      // Perpendicular unit vector
      const px = -Math.sin(angle);
      const py =  Math.cos(angle);

      const col = coloursFor(style);
      ctx.save();
      ctx.globalAlpha = style.alpha;

      if (style.look === 'return' || style.look === 'under') {
        // Dashed line, no band. A lower-tier arc bows to one side: the
        // control point sits off the midpoint, perpendicular to the arc.
        const bow = style.bow ?? 0;
        const cx = (sx + ex) / 2 + px * bow;
        const cy = (sy + ey) / 2 + py * bow;
        ctx.beginPath();
        ctx.moveTo(sx, sy);
        ctx.quadraticCurveTo(cx, cy, ex, ey);
        ctx.setLineDash([8, 7]);
        ctx.strokeStyle = col.dashed;
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.setLineDash([]);

        // The arrowhead follows the curve's tangent at its end.
        const ta = bow === 0 ? angle : Math.atan2(ey - cy, ex - cx);
        const tx = -Math.sin(ta), ty = Math.cos(ta);
        const rah = 11;
        ctx.beginPath();
        ctx.moveTo(ex + Math.cos(ta) * rah, ey + Math.sin(ta) * rah);
        ctx.lineTo(ex + tx * 5, ey + ty * 5);
        ctx.lineTo(ex - tx * 5, ey - ty * 5);
        ctx.closePath();
        ctx.fillStyle = col.arrow;
        ctx.fill();
        ctx.restore();
        return;
      }

      // Filled corridor band
      ctx.beginPath();
      ctx.moveTo(sx + px * cw, sy + py * cw);
      ctx.lineTo(ex + px * cw, ey + py * cw);
      ctx.lineTo(ex - px * cw, ey - py * cw);
      ctx.lineTo(sx - px * cw, sy - py * cw);
      ctx.closePath();
      ctx.fillStyle = col.fill;
      ctx.fill();
      ctx.strokeStyle = col.edge;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Centre highlight stripe
      ctx.beginPath();
      ctx.moveTo(sx, sy);
      ctx.lineTo(ex, ey);
      ctx.strokeStyle = col.stripe;
      ctx.lineWidth = 4;
      ctx.stroke();

      // Arrowhead at target end
      const ah = 14;
      ctx.beginPath();
      ctx.moveTo(ex + Math.cos(angle) * ah, ey + Math.sin(angle) * ah);
      ctx.lineTo(ex + px * 7, ey + py * 7);
      ctx.lineTo(ex - px * 7, ey - py * 7);
      ctx.closePath();
      ctx.fillStyle = col.arrow;
      ctx.fill();
      ctx.restore();
    }

When two corridors cross, the one drawn later is redrawn across the
crossing with a background-coloured halo, so the earlier one visibly
passes beneath it instead of merging into it. Only the stretch around the
crossing is redrawn, and not at all if the crossing is too close to either
end of the arc for the halo to fit between the corridor's clipped ends.

A bridge is drawn opaque, with its colours pre-mixed toward the background
when the arc is dimmed. Drawing it with partial alpha instead would stack
on top of the corridor already underneath and show up as a brighter patch.

    function blendOnBackground(hex: string, alpha: number): string {
      const bg = [0x11, 0x11, 0x11];
      const ch = (i: number) => parseInt(hex.slice(1 + 2 * i, 3 + 2 * i), 16);
      const mix = (i: number) => Math.round(bg[i] + (ch(i) - bg[i]) * alpha);
      return `rgb(${mix(0)},${mix(1)},${mix(2)})`;
    }

    function drawBridge(
      ctx: CanvasRenderingContext2D,
      x1: number, y1: number, x2: number, y2: number,
      cx: number, cy: number,
      style: CorridorStyle,
    ): void {
      const len = Math.hypot(x2 - x1, y2 - y1);
      if (len < 20 || style.look !== 'forward') return;
      const margin = Math.min(28, Math.max(8, len * 0.30));
      const cw = Math.min(16, Math.max(4, len * 0.18));
      const dStart = Math.hypot(cx - x1, cy - y1);
      const avail = Math.min(dStart, len - dStart) - margin;
      if (avail < 6) return;
      const half = Math.min(26, avail);
      const ux = (x2 - x1) / len, uy = (y2 - y1) / len;

      const col = coloursFor(style);
      const tone = (c: string) => blendOnBackground(c, style.alpha);
      ctx.save();
      ctx.lineCap = 'butt';
      ctx.beginPath();
      ctx.moveTo(cx - ux * half, cy - uy * half);
      ctx.lineTo(cx + ux * half, cy + uy * half);
      ctx.strokeStyle = '#111';
      ctx.lineWidth = cw * 2 + 8;
      ctx.stroke();
      ctx.strokeStyle = tone(col.edge);
      ctx.lineWidth = cw * 2;
      ctx.stroke();
      ctx.strokeStyle = tone(col.fill);
      ctx.lineWidth = cw * 2 - 3;
      ctx.stroke();
      ctx.strokeStyle = tone(col.stripe);
      ctx.lineWidth = 4;
      ctx.stroke();
      ctx.restore();
    }

##Drawing Places

Places are circles. The colour signals status: dark (empty), pellet visible
(has dot), chomper present, ghost present. Dot and chomper presence are
read from the #Game State marking; hasDot and nodeRadius come from the
#Game Map layer. When both a chomper and a ghost share a place, the ghost
is rendered above the chomper to make the danger immediately legible. When multiple chomper tokens occupy one place, a single chomper
icon is drawn with the count printed on its body — only shown when greater
than one, keeping the single-token case visually clean.

    function drawPlace(
      ctx: CanvasRenderingContext2D,
      p: Place,
      hasDot: boolean,
      chompers: number,
      ghosts: number,
      radius = 24,
      showLabel = false,
    ): void {
      ctx.beginPath();
      ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
      ctx.fillStyle = '#1a1a1a';
      ctx.fill();
      ctx.strokeStyle = chompers > 0 ? '#9a9aa2' : '#707078';
      ctx.lineWidth = 2;
      ctx.stroke();

      if (hasDot && chompers === 0) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 5, 0, Math.PI * 2);
        ctx.fillStyle = '#ffee88';
        ctx.fill();
      }

      // Draw ghosts first (below), chompers on top
      for (let j = 0; j < ghosts; j++) {
        const ox = (j - (ghosts - 1) / 2) * 16;
        const oy = chompers > 0 ? 8 : 0;
        drawGhost(ctx, p.x + ox, p.y + oy, 9);
      }
      if (chompers > 0) {
        const oy = ghosts > 0 ? -7 : 0;
        drawChomper(ctx, p.x, p.y + oy, 10);
        if (chompers > 1) {
          ctx.fillStyle = '#111';
          ctx.font = 'bold 9px monospace';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(String(chompers), p.x - 3, p.y + oy);
          ctx.textBaseline = 'alphabetic';
        }
      }

      if (!showLabel) return;
      ctx.fillStyle = '#a8a8b0';
      ctx.font = '10px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(p.label, p.x, p.y + radius + 13);
    }

##Drawing Chompers and Ghosts

    function drawChomper(
      ctx: CanvasRenderingContext2D,
      x: number, y: number, r: number,
    ): void {
      const mouth = 0.35;
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.arc(x, y, r, mouth, Math.PI * 2 - mouth);
      ctx.closePath();
      ctx.fillStyle = '#ffe000';
      ctx.fill();
    }

    function drawGhost(
      ctx: CanvasRenderingContext2D,
      x: number, y: number, r: number,
    ): void {
      ctx.beginPath();
      ctx.arc(x, y - r * 0.2, r, Math.PI, 0);
      ctx.lineTo(x + r, y + r * 0.8);
      const steps = 3;
      for (let i = 0; i < steps; i++) {
        const cx2 = x + r - (r * 2 / steps) * (i + 0.5);
        const dir  = i % 2 === 0 ? 1 : -1;
        ctx.quadraticCurveTo(
          cx2, y + r * 0.8 + dir * r * 0.4,
          x + r - (r * 2 / steps) * (i + 1), y + r * 0.8,
        );
      }
      ctx.closePath();
      ctx.fillStyle = '#cc44ff';
      ctx.fill();
    }

A chomper getting eaten is otherwise invisible — the token is just gone next
frame. drawEatenFlash draws a brief expanding, fading red ring over the spot
where it happened, driven purely by elapsed time since the #Game Engine
recorded the event; the renderer stays a pure read of state, it just also
reads the clock.

    const EATEN_FLASH_MS = 450;

    function drawEatenFlash(
      ctx: CanvasRenderingContext2D,
      x: number, y: number,
      radius: number, t: number,
    ): void {
      ctx.beginPath();
      ctx.arc(x, y, radius + t * 18, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(255,68,68,${1 - t})`;
      ctx.lineWidth = 4;
      ctx.stroke();
    }

##Drawing Transitions

Transitions are colour-coded by structural role. Forks (one input, multiple
outputs) use orange borders and a ">" chevron icon — the token splits into
two simultaneous streams. Joins (multiple inputs, one output) use cyan
borders and a "<" chevron icon — a sync barrier that only fires when all
input places are occupied. Regular one-to-one transitions keep the existing
yellow glow when enabled, grey when not.

Classification is computed from arc counts at render time; no extra field is
needed on the transition record.

    type TransitionKind = 'fork' | 'join' | 'regular';

    function transitionKind(net: PetriNet, id: string): TransitionKind {
      if (outputArcs(net, id).length > 1) return 'fork';
      if (inputArcs(net, id).length  > 1) return 'join';
      return 'regular';
    }

    function drawTransition(
      ctx: CanvasRenderingContext2D,
      t: Transition,
      enabled: boolean,
      kind: TransitionKind,
      showLabel = false,
    ): void {
      const w = 18, h = 40;

      const palette = {
        fork:    { bg: enabled ? '#552200' : '#1e0d00', border: enabled ? '#ff8800' : '#cc5500' },
        join:    { bg: enabled ? '#003344' : '#001520', border: enabled ? '#00ccff' : '#0088bb' },
        regular: { bg: enabled ? '#554400' : '#1a1a1a', border: enabled ? '#ffe000' : '#707078' },
      };
      const { bg, border } = palette[kind];

      ctx.fillStyle = bg;
      ctx.strokeStyle = border;
      ctx.lineWidth = enabled ? 3 : (kind === 'regular' ? 1 : 2);
      ctx.beginPath();
      ctx.rect(t.x - w / 2, t.y - h / 2, w, h);
      ctx.fill();
      ctx.stroke();

      // Chevron icon: ">" fan for fork, "<" merge for join
      if (kind === 'fork') {
        ctx.strokeStyle = enabled ? '#ffaa44' : '#995522';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(t.x - 3, t.y - 6);
        ctx.lineTo(t.x + 4, t.y);
        ctx.lineTo(t.x - 3, t.y + 6);
        ctx.stroke();
      } else if (kind === 'join') {
        ctx.strokeStyle = enabled ? '#44ddff' : '#006688';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(t.x + 3, t.y - 6);
        ctx.lineTo(t.x - 4, t.y);
        ctx.lineTo(t.x + 3, t.y + 6);
        ctx.stroke();
      }

      if (!showLabel) return;
      ctx.fillStyle = '#a8a8b0';
      ctx.font = '9px monospace';
      ctx.textAlign = 'center';
      ctx.fillText(t.label.slice(0, 8), t.x, t.y + h / 2 + 12);
    }

##Full Scene

The feedback arcs and crossings of a map never change while it is being
played, so they are worked out once per map and remembered rather than
recomputed every animation frame.

    const _feedbackCache = new WeakMap<GameNet, Set<string>>();
    const _crossingCache = new WeakMap<GameNet, Crossing[]>();

    interface Underpass { ids: Set<string>; cx: number; cy: number }
    const _underpassCache = new WeakMap<GameNet, Underpass>();

    function cachedFeedback(gn: GameNet): Set<string> {
      let fb = _feedbackCache.get(gn);
      if (!fb) { fb = returnArcs(gn.net, gn.playerStarts); _feedbackCache.set(gn, fb); }
      return fb;
    }

    // The lower-tier arcs, and the centre of the board they bow away from.
    function cachedUnderpass(gn: GameNet): Underpass {
      let u = _underpassCache.get(gn);
      if (!u) {
        const nodes = [...gn.net.places.values(), ...gn.net.transitions.values()];
        const n = Math.max(1, nodes.length);
        u = {
          ids: underpassArcIds(gn),
          cx: nodes.reduce((s, p) => s + p.x, 0) / n,
          cy: nodes.reduce((s, p) => s + p.y, 0) / n,
        };
        _underpassCache.set(gn, u);
      }
      return u;
    }

    function cachedCrossings(gn: GameNet): Crossing[] {
      let cr = _crossingCache.get(gn);
      if (!cr) {
        cr = arcCrossings(gn.net, cachedUnderpass(gn).ids);
        _crossingCache.set(gn, cr);
      }
      return cr;
    }

    function render(
      r: Renderer, engine: Engine, focusId: string | null = null,
    ): void {
      clearCanvas(r);
      const { state } = engine;
      const net = state.gn.net;
      const ctx = r.ctx;
      const nodeRadius = state.gn.nodeRadius ?? 24;

      const enabledIds = new Set(
        engine.phase === 'player' ? playerEnabledTransitions(engine) : []
      );

      const feedback = cachedFeedback(state.gn);
      const under = cachedUnderpass(state.gn);
      const posOf = (id: string) => net.places.get(id) ?? net.transitions.get(id);

      // A lower-tier arc bows away from the board's centre, by a fraction
      // of its length, so a long one sweeps wide and a short one not at
      // all. Both halves of a route (place to doorway, doorway to place)
      // pick their side from the whole route's chord, from the place
      // before the doorway to the place after it, so they bow the same
      // way and join into one smooth curve instead of an S.
      const bowOf = (arc: Arc): number => {
        const a = posOf(arc.source), b = posOf(arc.target);
        if (!a || !b) return 0;
        const len = Math.hypot(b.x - a.x, b.y - a.y);
        if (len < 100) return 0;
        const door = net.transitions.has(arc.source) ? arc.source : arc.target;
        const ins = inputArcs(net, door), outs = outputArcs(net, door);
        const from = ins.length === 1 ? posOf(ins[0].source) : a;
        const to = outs.length === 1 ? posOf(outs[0].target) : b;
        if (!from || !to) return 0;
        const cl = Math.hypot(to.x - from.x, to.y - from.y) || 1;
        const qx = -(to.y - from.y) / cl, qy = (to.x - from.x) / cl;
        const side = ((from.x + to.x) / 2 - under.cx) * qx +
                     ((from.y + to.y) / 2 - under.cy) * qy >= 0 ? 1 : -1;
        return side * Math.min(110, len * 0.25);
      };

      const styleOf = (arc: Arc): CorridorStyle => {
        const adjacent = focusId !== null &&
          (arc.source === focusId || arc.target === focusId);
        const lower = under.ids.has(arc.id);
        return {
          look: lower ? 'under' : feedback.has(arc.id) ? 'return' : 'forward',
          alpha: focusId === null || adjacent ? 1 : DIM_ALPHA,
          accent: adjacent,
          muted: enabledIds.has(arc.source) || enabledIds.has(arc.target),
          ...(lower ? { bow: bowOf(arc) } : {}),
        };
      };

      // Draw corridors first (behind everything)
      for (const arc of net.arcs) {
        const src = posOf(arc.source), tgt = posOf(arc.target);
        if (src && tgt) drawCorridor(ctx, src.x, src.y, tgt.x, tgt.y, styleOf(arc));
      }
      for (const c of cachedCrossings(state.gn)) {
        const a = posOf(c.b.source), b = posOf(c.b.target);
        if (a && b) drawBridge(ctx, a.x, a.y, b.x, b.y, c.x, c.y, styleOf(c.b));
      }

      // Transitions
      for (const t of net.transitions.values()) {
        drawTransition(
          ctx, t, enabledIds.has(t.id), transitionKind(net, t.id), r.showLabels,
        );
      }

      // Places (on top of corridors)
      for (const p of net.places.values()) {
        const gp = p as GamePlace;
        drawPlace(
          ctx, p,
          gp.hasDot && state.dots.has(p.id),
          tokenCount(state.chompers, p.id),
          tokenCount(state.ghosts, p.id),
          nodeRadius,
          r.showLabels,
        );
      }

      // The places a focused doorway reads from and writes to get a ring.
      if (focusId !== null) {
        ctx.save();
        ctx.strokeStyle = '#ffe000';
        ctx.globalAlpha = 0.75;
        ctx.lineWidth = 2;
        for (const arc of net.arcs) {
          if (arc.source !== focusId && arc.target !== focusId) continue;
          const other = posOf(arc.source === focusId ? arc.target : arc.source);
          if (!other) continue;
          ctx.beginPath();
          ctx.arc(other.x, other.y, nodeRadius + 6, 0, Math.PI * 2);
          ctx.stroke();
        }
        ctx.restore();
      }

      // A ghost catching a chomper flashes the spot briefly.
      if (engine.eaten) {
        const elapsed = Date.now() - engine.eaten.at;
        if (elapsed < EATEN_FLASH_MS) {
          const t = elapsed / EATEN_FLASH_MS;
          for (const placeId of engine.eaten.places) {
            const p = net.places.get(placeId);
            if (p) drawEatenFlash(ctx, p.x, p.y, nodeRadius, t);
          }
        }
      }

      endfont = '18px monospace';
      endmsg = 'press R to restart, ESC to choose another map';


      // HUD
      ctx.fillStyle = '#ccc';
      ctx.font = '15px monospace';
      ctx.textAlign = 'left';
      ctx.fillText(`Score: ${state.score}   Lives: ${state.lives}`, 12, 24);

      if (engine.phase === 'won') {
        ctx.fillStyle = 'rgba(0,0,0,0.55)';
        ctx.fillRect(0, 0, r.canvas.width, r.canvas.height);
        ctx.textAlign = 'center';
        ctx.fillStyle = '#ffe000';
        ctx.font = 'bold 64px monospace';
        ctx.fillText('YOU WIN', r.canvas.width / 2, r.canvas.height / 2 - 10);
        ctx.fillStyle = '#888';
        ctx.font = endfont;
        ctx.fillText(endmsg, r.canvas.width / 2, r.canvas.height / 2 + 62);
      }
      if (engine.phase === 'lost') {
        ctx.fillStyle = 'rgba(0,0,0,0.65)';
        ctx.fillRect(0, 0, r.canvas.width, r.canvas.height);
        ctx.textAlign = 'center';
        ctx.fillStyle = '#cc0000';
        ctx.font = 'bold 80px monospace';
        ctx.fillText('GAME OVER', r.canvas.width / 2, r.canvas.height / 2 - 16);
        ctx.fillStyle = '#ff4444';
        ctx.font = 'bold 28px monospace';
        ctx.fillText(`${state.lives} ${state.lives === 1 ? 'life' : 'lives'} remaining`, r.canvas.width / 2, r.canvas.height / 2 + 30);
        ctx.fillStyle = '#666';
        ctx.font = endfont;
        ctx.fillText(endmsg, r.canvas.width / 2, r.canvas.height / 2 + 62);
      }
    }


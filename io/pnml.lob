#IO PNML

PNML (Petri Net Markup Language) is the standard XML exchange format for Petri
nets. This module handles both export and import.

Export serialises a GameNet to a PNML string. The standard elements carry the
net topology and layout positions. Game-specific data (playerStart,
ghostStart, dots, nodeRadius) lives in toolspecific elements so vanilla
PNML readers ignore it cleanly.

Both kinds of token start the same way, as a mark on a place: playerStart for
the chomper, ghostStart for a ghost. A bare ghostStart means one ghost, and a
count, ghostStart with the number as its text, means that many. An earlier
version marked a transition as a ghost spawn instead, which put the ghost on
that transition's first output place; that form is no longer read, so a map
marking ghosts that way loads with none.

Import is split into two functions. buildGameNet takes plain #RawPlace,
#RawTrans, and #RawArc records and assembles a GameNet: it scale-fits all
positions to the 950×780 canvas, builds the net, resolves playerStarts
(all toolspecific playerStart elements > all initialMarking places > first
place as fallback), and collects the ghostStart marking. importPNML is a thin browser
wrapper: it calls DOMParser to parse the XML string into a Document,
extracts the raw records, then delegates to buildGameNet.

This split means the assembly logic is testable without a browser.
importPNML itself cannot be claimed — DOMParser is not available in the
tsx runtime — but buildGameNet can be. The full XML round-trip therefore
remains documented in prose rather than the claim layer.

When loading vanilla PNML (no toolspecific extensions), safe defaults
apply: every place gets a dot, the first marked place is added to
playerStarts, and there are no ghosts.

    function exportPNML(gn: GameNet, netName: string): string {
      const { net } = gn;
      const lines: string[] = [];

      lines.push('<?xml version="1.0" encoding="UTF-8"?>');
      lines.push('<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">');
      lines.push(`  <net id="pn-chomper" type="http://www.pnml.org/version-2009/grammar/ptnet">`);
      lines.push(`    <name><text>${escXml(netName)}</text></name>`);

      // Net-level toolspecific
      lines.push('    <toolspecific tool="pn-chomper" version="1.0">');
      if (gn.nodeRadius !== undefined) {
        lines.push(`      <nodeRadius>${gn.nodeRadius}</nodeRadius>`);
      }
      lines.push('    </toolspecific>');

      lines.push('    <page id="page1">');

      // Places
      for (const p of net.places.values()) {
        lines.push(`      <place id="${escXml(p.id)}">`);
        lines.push(`        <name><text>${escXml(p.label)}</text></name>`);
        lines.push(`        <graphics><position x="${p.x}" y="${p.y}"/></graphics>`);
        const marking = gn.startMarkings?.get(p.id) ?? (gn.playerStarts.includes(p.id) ? 1 : 0);
        lines.push(`        <initialMarking><text>${marking}</text></initialMarking>`);
        lines.push('        <toolspecific tool="pn-chomper" version="1.0">');
        if (gn.playerStarts.includes(p.id)) lines.push('          <playerStart/>');
        const ghosts = tokenCount(gn.ghostStart, p.id);
        if (ghosts === 1)  lines.push('          <ghostStart/>');
        if (ghosts > 1)    lines.push(`          <ghostStart>${ghosts}</ghostStart>`);
        // One dot per place is the default, so only a different count is written.
        const dots = tokenCount(gn.dotStart, p.id);
        if (dots !== 1)    lines.push(`          <dots>${dots}</dots>`);
        lines.push('        </toolspecific>');
        lines.push('      </place>');
      }

      // Transitions
      for (const t of net.transitions.values()) {
        lines.push(`      <transition id="${escXml(t.id)}">`);
        lines.push(`        <name><text>${escXml(t.label)}</text></name>`);
        lines.push(`        <graphics><position x="${t.x}" y="${t.y}"/></graphics>`);
        lines.push('      </transition>');
      }

      // Arcs
      for (const arc of net.arcs) {
        lines.push(`      <arc id="${escXml(arc.id)}" source="${escXml(arc.source)}" target="${escXml(arc.target)}">`);
        lines.push(`        <inscription><text>${arc.weight}</text></inscription>`);
        lines.push('      </arc>');
      }

      lines.push('    </page>');
      lines.push('  </net>');
      lines.push('</pnml>');

      return lines.join('\n');
    }

    function escXml(s: string): string {
      return s.replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
    }

    type RawPlace = {
      id: string; label: string; x: number; y: number;
      dots: number; isStart: boolean; marking: number;
      ghostStart?: number;    // ghosts that begin here; absent or 0 for none
    };
    type RawTrans = { id: string; label: string; x: number; y: number };
    type RawArc   = { id: string; src: string; tgt: string; weight: number };

    function buildGameNet(
      rawPlaces: RawPlace[],
      rawTrans:  RawTrans[],
      rawArcs:   RawArc[],
      nodeRadius?: number,
    ): GameNet {
      const allX = [...rawPlaces, ...rawTrans].map(n => n.x);
      const allY = [...rawPlaces, ...rawTrans].map(n => n.y);
      const minX = Math.min(...allX), maxX = Math.max(...allX);
      const minY = Math.min(...allY), maxY = Math.max(...allY);
      const PAD = 80, CW = 950, CH = 780;
      const sc  = Math.min(
        (maxX > minX) ? (CW - 2 * PAD) / (maxX - minX) : 1,
        (maxY > minY) ? (CH - 2 * PAD) / (maxY - minY) : 1,
      );
      const fx = (x: number) => (x - minX) * sc + PAD;
      const fy = (y: number) => (y - minY) * sc + PAD;

      const net = makeNet();
      for (const p of rawPlaces) {
        const gp = addPlace(net, p.id, p.label, fx(p.x), fy(p.y)) as GamePlace;
        gp.dots = p.dots;
      }
      for (const t of rawTrans) {
        addTransition(net, t.id, t.label, fx(t.x), fy(t.y));
      }
      for (const arc of rawArcs) {
        try { addArc(net, arc.id, arc.src, arc.tgt, arc.weight); } catch { /* skip malformed arcs */ }
      }

      type StartEntry = { id: string; count: number };
      let startEntries: StartEntry[];
      const isStartPlaces = rawPlaces.filter(p => p.isStart);
      if (isStartPlaces.length > 0) {
        startEntries = isStartPlaces.map(p => ({ id: p.id, count: p.marking > 0 ? p.marking : 1 }));
      } else {
        const markedPlaces = rawPlaces.filter(p => p.marking > 0);
        if (markedPlaces.length > 0) {
          startEntries = markedPlaces.map(p => ({ id: p.id, count: p.marking }));
        } else {
          startEntries = rawPlaces[0] ? [{ id: rawPlaces[0].id, count: 1 }] : [];
        }
      }
      const playerStarts   = startEntries.map(e => e.id);
      const startMarkings  = new Map(startEntries.map(e => [e.id, e.count]));

      const ghostStart = emptyMarking();
      for (const p of rawPlaces) {
        if ((p.ghostStart ?? 0) > 0) markingAddTokens(ghostStart, p.id, p.ghostStart!);
      }

      const dotStart = dotsOf(net);

      return {
        net, playerStarts, startMarkings, ghostStart, dotStart,
        ...(nodeRadius !== undefined ? { nodeRadius } : {}),
      };
    }

A ghostStart element with no text is one ghost, with a number its count, and a
missing element is none; anything that does not read as a positive number
counts as one, since the element is there.

    function ghostCount(el: Element | null | undefined): number {
      if (!el) return 0;
      const n = parseInt(el.textContent?.trim() ?? '', 10);
      return n > 0 ? n : 1;
    }

A place has one dot unless its dots element says otherwise: no element, or no
number in it, is one, and a number is that many, zero suppressing the dot.

    function dotCount(el: Element | null | undefined): number {
      if (!el) return 1;
      const n = parseInt(el.textContent?.trim() ?? '', 10);
      return Number.isNaN(n) || n < 0 ? 1 : n;
    }

    function importPNML(xmlString: string): GameNet {
      const doc = new DOMParser().parseFromString(xmlString, 'application/xml');
      if (doc.querySelector('parsererror'))
        throw new Error('PNML parse error');

      function nodeText(el: Element, sel: string): string {
        return el.querySelector(sel)?.textContent?.trim() ?? '';
      }
      function nodePos(el: Element): { x: number; y: number } {
        const p = el.querySelector('graphics > position');
        return { x: parseFloat(p?.getAttribute('x') ?? '0'), y: parseFloat(p?.getAttribute('y') ?? '0') };
      }

      const rawPlaces: RawPlace[] = [];
      for (const el of doc.querySelectorAll('place')) {
        const id = el.getAttribute('id') ?? '';
        const ts = el.querySelector('toolspecific[tool="pn-chomper"]');
        rawPlaces.push({
          id, label: nodeText(el, 'name > text') || id,
          ...nodePos(el),
          dots:    dotCount(ts?.querySelector('dots')),
          isStart: !!ts?.querySelector('playerStart'),
          marking: parseInt(nodeText(el, 'initialMarking > text') || '0', 10),
          ghostStart: ghostCount(ts?.querySelector('ghostStart')),
        });
      }

      const rawTrans: RawTrans[] = [];
      for (const el of doc.querySelectorAll('transition')) {
        const id = el.getAttribute('id') ?? '';
        rawTrans.push({
          id, label: nodeText(el, 'name > text') || id,
          ...nodePos(el),
        });
      }

      const rawArcs: RawArc[] = [];
      for (const el of doc.querySelectorAll('arc')) {
        rawArcs.push({
          id:     el.getAttribute('id') ?? '',
          src:    el.getAttribute('source') ?? '',
          tgt:    el.getAttribute('target') ?? '',
          weight: parseInt(el.querySelector('inscription > text')?.textContent?.trim() ?? '1', 10),
        });
      }

      const nrText = doc.querySelector('net > toolspecific[tool="pn-chomper"] > nodeRadius')
                       ?.textContent?.trim();
      const nodeRadius = nrText ? parseInt(nrText, 10) : undefined;

      return buildGameNet(rawPlaces, rawTrans, rawArcs, nodeRadius);
    }

    function downloadPNML(gn: GameNet, name: string): void {
      const xml  = exportPNML(gn, name);
      const blob = new Blob([xml], { type: 'application/xml' });
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement('a');
      a.href     = url;
      a.download = name.replace(/[^a-z0-9]/gi, '_').toLowerCase() + '.pnml';
      a.click();
      URL.revokeObjectURL(url);
    }

The buildGameNet examples below use hand-constructed raw records to verify
assembly without a browser.

    const _rp1: RawPlace = { id: 'a', label: 'A', x: 0,   y: 0, dots: 1, isStart: true,  marking: 0 };
    const _rp2: RawPlace = {
      id: 'b', label: 'B', x: 100, y: 0, dots: 3, isStart: false,
      marking: 0, ghostStart: 2,
    };
    const _rt1: RawTrans = { id: 't', label: 'T', x: 50,  y: 0 };
    const _ra1: RawArc   = { id: 'arc1', src: 'a', tgt: 't', weight: 1 };
    const _builtGn = buildGameNet([_rp1, _rp2], [_rt1], [_ra1]);

~example
    _builtGn.playerStarts.includes('a')
    tokenCount(_builtGn.ghostStart, 'b') === 2
    tokenCount(_builtGn.ghostStart, 'a') === 0
    _builtGn.net.places.has('a')
    _builtGn.net.places.has('b')
    tokenCount(_builtGn.dotStart, 'a') === 1
    tokenCount(_builtGn.dotStart, 'b') === 3
    _builtGn.net.arcs.length === 1

~property playerStarts_from_isStart
    fc.assert(fc.property(
      fc.integer({ min: 0, max: 5 }),
      fc.integer({ min: 1, max: 5 }),
      (startIdx, total) => {
        const places: RawPlace[] = Array.from({ length: total }, (_, i) => ({
          id: `p${i}`, label: `P${i}`, x: i * 10, y: 0,
          dots: 1, isStart: i === startIdx % total, marking: 0,
        }));
        const gn = buildGameNet(places, [], []);
        return gn.playerStarts.includes(`p${startIdx % total}`);
      }
    ))

~property all_isStart_in_playerStarts
    fc.assert(fc.property(
      fc.array(fc.boolean(), { minLength: 1, maxLength: 10 }),
      (isStartFlags) => {
        const places: RawPlace[] = isStartFlags.map((isStart, i) => ({
          id: `p${i}`, label: `P${i}`, x: i * 10, y: 0,
          dots: 1, isStart, marking: 0,
        }));
        const gn = buildGameNet(places, [], []);
        const expected = places.filter(p => p.isStart).map(p => p.id);
        return expected.length === 0 ||
          expected.every(id => gn.playerStarts.includes(id));
      }
    ))

~property scale_fit_positions_within_canvas
    fc.assert(fc.property(
      fc.array(fc.record({ x: fc.integer({ min: -1000, max: 1000 }), y: fc.integer({ min: -1000, max: 1000 }) }), { minLength: 2, maxLength: 10 }),
      (coords) => {
        const places: RawPlace[] = coords.map((c, i) => ({
          id: `p${i}`, label: `P${i}`, x: c.x, y: c.y,
          dots: 1, isStart: i === 0, marking: 0,
        }));
        const gn = buildGameNet(places, [], []);
        const PAD = 80, CW = 950, CH = 780, EPS = 1e-9;
        return [...gn.net.places.values()].every(p =>
          p.x >= PAD - EPS && p.x <= CW - PAD + EPS &&
          p.y >= PAD - EPS && p.y <= CH - PAD + EPS
        );
      }
    ))

~property place_ids_preserved
    fc.assert(fc.property(
      fc.integer({ min: 1, max: 20 }),
      (n) => {
        const places: RawPlace[] = Array.from({ length: n }, (_, i) => ({
          id: `p${i}`, label: `P${i}`, x: i * 10, y: 0,
          dots: 1, isStart: i === 0, marking: 0,
        }));
        const gn = buildGameNet(places, [], []);
        return places.every(p => gn.net.places.has(p.id));
      }
    ))

~property dotStart_marking_matches_raw_counts
    fc.assert(fc.property(
      fc.array(fc.integer({ min: 0, max: 4 }), { minLength: 1, maxLength: 10 }),
      (counts) => {
        const places: RawPlace[] = counts.map((dots, i) => ({
          id: `p${i}`, label: `P${i}`, x: i * 10, y: 0,
          dots, isStart: i === 0, marking: 0,
        }));
        const gn = buildGameNet(places, [], []);
        return counts.every((n, i) => tokenCount(gn.dotStart, `p${i}`) === n);
      }
    ))

~property ghostStart_marking_matches_raw_counts
    fc.assert(fc.property(
      fc.array(fc.integer({ min: 0, max: 4 }), { minLength: 1, maxLength: 10 }),
      (counts) => {
        const places: RawPlace[] = counts.map((ghostStart, i) => ({
          id: `p${i}`, label: `P${i}`, x: i * 10, y: 0,
          dots: 1, isStart: i === 0, marking: 0, ghostStart,
        }));
        const gn = buildGameNet(places, [], []);
        return counts.every((n, i) => tokenCount(gn.ghostStart, `p${i}`) === n);
      }
    ))

~example
    exportPNML(makeSplitMap(), 'Split').includes('<pnml')
    exportPNML(makeSplitMap(), 'Split').includes('playerStart')
    exportPNML(makeSplitMap(), 'Split').includes('ghostStart')
    exportPNML(makeSplitMap(), 'Split').includes('<arc ')

~example
    exportPNML(makeGridMap(), 'Grid').includes('<nodeRadius>12</nodeRadius>')
    exportPNML(makeGridMap(), 'Grid').includes('<dots>0</dots>')
    exportPNML(_builtGn, 'Dots').includes('<dots>3</dots>')

---

#Tests

##export produces valid XML structure
    exportPNML(makeClassicMap(), 'Classic').includes('<?xml version="1.0"')
    exportPNML(makeClassicMap(), 'Classic').includes('</pnml>')

##every place and transition appears in the export
    exportPNML(makeSplitMap(), 'Split').includes('id="start"')
    exportPNML(makeSplitMap(), 'Split').includes('id="t_fork"')
    exportPNML(makeSplitMap(), 'Split').includes('id="b1"')

##playerStart gets initialMarking 1, others get 0
    exportPNML(makeSplitMap(), 'Split').includes('<initialMarking><text>1</text></initialMarking>')

##ghostStart place is marked, and no transition carries a spawn mark
    exportPNML(makeSplitMap(), 'Split').includes('<ghostStart/>')
    !exportPNML(makeSplitMap(), 'Split').includes('ghostSpawn')

##a place with several ghosts exports its count
    exportPNML(_builtGn, 'Two').includes('<ghostStart>2</ghostStart>')

##playerStart place is marked
    exportPNML(makeSplitMap(), 'Split').includes('<playerStart/>')

##nodeRadius appears when set
    exportPNML(makeGridMap(), 'Grid').includes('<nodeRadius>12</nodeRadius>')

##nodeRadius absent when not set
    !exportPNML(makeClassicMap(), 'Classic').includes('<nodeRadius>')

##special XML characters are escaped
    escXml('a & b < c > d "e"') === 'a &amp; b &lt; c &gt; d &quot;e&quot;'



#Petri Net

A Petri net is a directed bipartite graph of Places and Transitions connected
by Arcs. This module defines the static structure — the map — without any
notion of current token positions. A separate marking module tracks which
places hold tokens at any moment.

Places are the nodes where tokens reside. In the game they are rooms. Each
place has a unique id, a human label, and a position for rendering.

Transitions are the events that consume tokens from input places and produce
tokens in output places. In the game they are doorways. A transition is
enabled when every input place holds at least one token (for weight-1 arcs).

Arcs connect places to transitions (input arcs) or transitions to places
(output arcs). Each arc has an integer weight (default 1) determining how
many tokens are consumed or produced.

    interface Place {
      readonly id: string;
      label: string;
      x: number;
      y: number;
    }

    interface Transition {
      readonly id: string;
      label: string;
      x: number;
      y: number;
    }

    interface Arc {
      readonly id: string;
      readonly source: string;
      readonly target: string;
      readonly weight: number;
    }

    interface PetriNet {
      places: Map<string, Place>;
      transitions: Map<string, Transition>;
      arcs: Arc[];
    }

A net is built with the constructor functions below. They validate that arcs
connect the correct node kinds (place to transition or transition to place) and
that referenced ids exist.

    function makeNet(): PetriNet {
      return { places: new Map(), transitions: new Map(), arcs: [] };
    }

    function addPlace(
      net: PetriNet, id: string, label: string, x: number, y: number,
    ): Place {
      if (net.places.has(id)) throw new Error(`Place '${id}' already exists`);
      const p: Place = { id, label, x, y };
      net.places.set(id, p);
      return p;
    }

    function addTransition(
      net: PetriNet, id: string, label: string, x: number, y: number,
    ): Transition {
      if (net.transitions.has(id)) throw new Error(`Transition '${id}' already exists`);
      const t: Transition = { id, label, x, y };
      net.transitions.set(id, t);
      return t;
    }

    function addArc(
      net: PetriNet, id: string, source: string, target: string, weight = 1,
    ): Arc {
      const srcIsPlace = net.places.has(source);
      const srcIsTransition = net.transitions.has(source);
      const tgtIsPlace = net.places.has(target);
      const tgtIsTransition = net.transitions.has(target);
      if (!srcIsPlace && !srcIsTransition)
        throw new Error(`Arc source '${source}' not found`);
      if (!tgtIsPlace && !tgtIsTransition)
        throw new Error(`Arc target '${target}' not found`);
      if (srcIsPlace && tgtIsPlace)
        throw new Error(`Arc cannot connect two places`);
      if (srcIsTransition && tgtIsTransition)
        throw new Error(`Arc cannot connect two transitions`);
      const arc: Arc = { id, source, target, weight };
      net.arcs.push(arc);
      return arc;
    }

##Queries

Convenience accessors used by the marking and renderer modules.

    function inputArcs(net: PetriNet, transitionId: string): Arc[] {
      return net.arcs.filter(
        a => a.target === transitionId && net.places.has(a.source),
      );
    }

    function outputArcs(net: PetriNet, transitionId: string): Arc[] {
      return net.arcs.filter(
        a => a.source === transitionId && net.places.has(a.target),
      );
    }

    function transitionsForPlace(net: PetriNet, placeId: string): Transition[] {
      const ids = net.arcs.filter(a => a.source === placeId).map(a => a.target);
      return ids.map(id => net.transitions.get(id)!);
    }

A feedback arc is one that closes a cycle: it points back at a node that
is still being explored on the path from a start place. Following arcs
depth first from the start places, every arc whose target is currently
on the path is flagged. This is structural — it needs no names, no marked
roles and no marking — so it applies unchanged to any net, including one
loaded from outside. Which arc of a cycle gets flagged can depend on arc
declaration order, but every cycle contributes at least one, and arcs
into a join from a longer branch are not flagged (they close no cycle).

    function feedbackArcs(net: PetriNet, starts: string[]): Set<string> {
      const out = new Map<string, Arc[]>();
      for (const a of net.arcs) {
        const list = out.get(a.source);
        if (list) list.push(a); else out.set(a.source, [a]);
      }
      const state = new Map<string, number>();  // 1 = on path, 2 = done
      const back = new Set<string>();
      for (const s of starts) {
        if (state.has(s)) continue;
        state.set(s, 1);
        const stack: Array<[string, number]> = [[s, 0]];
        while (stack.length > 0) {
          const top = stack[stack.length - 1];
          const arcs = out.get(top[0]) ?? [];
          if (top[1] >= arcs.length) { state.set(top[0], 2); stack.pop(); continue; }
          const a = arcs[top[1]++];
          const st = state.get(a.target);
          if (st === 1) back.add(a.id);
          else if (st === undefined) {
            state.set(a.target, 1);
            stack.push([a.target, 0]);
          }
        }
      }
      return back;
    }

A return transition is one whose every output arc is a feedback arc: it
exists only to carry tokens back. Drawing just its outgoing half as a return
reads as a forward corridor that mysteriously ends in a dashed one, so the
arcs feeding it are part of the return too. A transition that also forks
forward (some outputs not feedback) is not a return transition, and its
inputs stay forward.

    function returnArcs(net: PetriNet, starts: string[]): Set<string> {
      const back = feedbackArcs(net, starts);
      const result = new Set(back);
      for (const t of net.transitions.keys()) {
        const outs = outputArcs(net, t);
        if (outs.length > 0 && outs.every(a => back.has(a.id))) {
          for (const a of inputArcs(net, t)) result.add(a.id);
        }
      }
      return result;
    }

Here is a small net used by the examples below: one place feeding a
transition that fans out to two output places (the classic split).

    const _testNet = makeNet();
    addPlace(_testNet, 'p1', 'Start', 0, 0);
    addTransition(_testNet, 't1', 'Door', 100, 0);
    addPlace(_testNet, 'p2', 'Left', 200, -50);
    addPlace(_testNet, 'p3', 'Right', 200, 50);
    addArc(_testNet, 'a1', 'p1', 't1');
    addArc(_testNet, 'a2', 't1', 'p2');
    addArc(_testNet, 'a3', 't1', 'p3');

    function _throwsOnBadArc(): boolean {
      try { addArc(_testNet, 'bad', 'p1', 'p2'); return false; }
      catch { return true; }
    }

A loop (p0 → t0 → p1 → t1 → back to p0), and a split whose two branches
have different lengths before they rejoin — the second shape is the one a
distance-based rule would wrongly flag.

    function _loopNet(): PetriNet {
      const n = makeNet();
      addPlace(n, 'p0', 'A', 0, 0);   addPlace(n, 'p1', 'B', 200, 0);
      addTransition(n, 't0', 'T0', 100, 0);
      addTransition(n, 't1', 'T1', 100, 100);
      addArc(n, 'c1', 'p0', 't0');  addArc(n, 'c2', 't0', 'p1');
      addArc(n, 'c3', 'p1', 't1');  addArc(n, 'c4', 't1', 'p0');
      return n;
    }

    function _unevenJoinNet(): PetriNet {
      const n = makeNet();
      for (const id of ['p0', 'pa', 'pc', 'pb', 'pd', 'pe', 'pf'])
        addPlace(n, id, id, 0, 0);
      for (const id of ['t0', 'ta', 'tb', 'tc', 'tj'])
        addTransition(n, id, id, 0, 0);
      addArc(n, 'j1', 'p0', 't0');  addArc(n, 'j2', 't0', 'pa');
      addArc(n, 'j3', 't0', 'pb');  addArc(n, 'j4', 'pa', 'ta');
      addArc(n, 'j5', 'ta', 'pc');  addArc(n, 'j6', 'pb', 'tb');
      addArc(n, 'j7', 'tb', 'pd');  addArc(n, 'j8', 'pd', 'tc');
      addArc(n, 'j9', 'tc', 'pe');  addArc(n, 'j10', 'pc', 'tj');
      addArc(n, 'j11', 'pe', 'tj'); addArc(n, 'j12', 'tj', 'pf');
      return n;
    }

~example
    _testNet.places.has('p1')
    _testNet.places.get('p1')!.label === 'Start'
    _testNet.transitions.has('t1')
    inputArcs(_testNet, 't1').length === 1
    inputArcs(_testNet, 't1')[0].source === 'p1'
    outputArcs(_testNet, 't1').length === 2
    _throwsOnBadArc()

---

#Tests

##place and transition ids are preserved
    _testNet.places.get('p1')!.id === 'p1'
    _testNet.transitions.get('t1')!.id === 't1'

##transitionsForPlace finds downstream transitions
    transitionsForPlace(_testNet, 'p1').length === 1
    transitionsForPlace(_testNet, 'p1')[0].id === 't1'

##arc weight defaults to 1
    inputArcs(_testNet, 't1')[0].weight === 1

##a loop has exactly one feedback arc, the one closing it
    feedbackArcs(_loopNet(), ['p0']).size === 1
    feedbackArcs(_loopNet(), ['p0']).has('c4')

##a split with no cycle has no feedback arcs
    feedbackArcs(_testNet, ['p1']).size === 0

##joining a longer branch is not feedback
    feedbackArcs(_unevenJoinNet(), ['p0']).size === 0

##a return transition's input arc is part of the return, nothing else is
    returnArcs(_loopNet(), ['p0']).size === 2
    returnArcs(_loopNet(), ['p0']).has('c3')
    returnArcs(_loopNet(), ['p0']).has('c4')
    returnArcs(_unevenJoinNet(), ['p0']).size === 0

